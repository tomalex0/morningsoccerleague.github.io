{
  "name": "morningsoccerleague.github.io",
  "private": true,
  "description": "Morning Soccer League Web Codebase using Gatsby",
  "version": "1.1.1",
  "author": "Thomas Alexander <tomalex0@gmail.com>",
  "dependencies": {
    "@reach/router": "^1.3.4",
    "@tailwindcss/forms": "^0.5.0",
    "autoprefixer": "^10.4.4",
    "gatsby": "^4.11.1",
    "gatsby-plugin-google-analytics": "^4.11.0",
    "gatsby-plugin-image": "^2.11.1",
    "gatsby-plugin-manifest": "^4.11.1",
    "gatsby-plugin-offline": "^5.11.1",
    "gatsby-plugin-postcss": "^5.11.0",
    "gatsby-plugin-react-helmet": "^5.11.0",
    "gatsby-plugin-sharp": "^4.11.1",
    "gatsby-plugin-sitemap": "^5.11.1",
    "gatsby-plugin-webpack-bundle-analyser-v2": "^1.1.27",
    "gatsby-source-filesystem": "^4.11.1",
    "gatsby-transformer-json": "^4.11.0",
    "gatsby-transformer-remark": "^5.11.1",
    "gatsby-transformer-sharp": "^4.11.0",
    "postcss": "^8.4.12",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-helmet": "^6.1.0",
    "styled-components": "^5.3.5",
    "tailwindcss": "^3.0.23",
    "typescript": "^4.6.3"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.16.7",
    "@cypress/code-coverage": "^3.9.12",
    "@typescript-eslint/parser": "^5.17.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-istanbul": "^6.1.1",
    "babel-plugin-transform-class-properties": "^6.24.1",
    "cypress": "^9.5.3",
    "eslint": "^8.12.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-react-app": "^7.0.0",
    "eslint-plugin-cypress": "^2.12.1",
    "eslint-plugin-prettier": "^4.0.0",
    "istanbul-lib-coverage": "^3.2.0",
    "mochawesome": "^7.1.3",
    "mochawesome-merge": "^4.2.1",
    "mochawesome-report-generator": "^6.2.0",
    "nyc": "^15.1.0",
    "path-browserify": "^1.0.1",
    "prettier": "^2.6.1",
    "transform-class-properties": "^1.0.0-beta"
  },
  "keywords": [
    "gatsby"
  ],
  "license": "0BSD",
  "scripts": {
    "build": "gatsby build",
    "lint": "eslint . --ignore-path .prettierignore",
    "lint:fix": "eslint .  --fix",
    "build:prefix": "gatsby build --prefix-paths --log-pages",
    "develop": "gatsby develop -H 0.0.0.0",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve -H 0.0.0.0",
    "clean": "gatsby clean",
    "check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "cy:open": "cypress open",
    "cy:run": "cypress run --spec 'cypress/integration/**/*'",
    "cy:run:file": "cypress run",
    "delete-e2e:reports": "rm cypress/results/e2e/* && rm e2e-mochawesome.json || true",
    "delete-unit:reports": "rm cypress/results/unit/* && rm unit-mochawesome.json || true",
    "preunit-test": "npm run delete-unit:reports",
    "pree2e-test": "npm run delete-e2e:reports",
    "e2e-test": "cypress run --spec  'cypress/integration/ui-test/**/*' --headless --env coverage=false && npm run e2e-merge && npm run e2e-report",
    "unit-test": "cypress run --config-file cypress-unit-test.json --spec  'cypress/integration/unit-test/**/*' --env coverage=true && npm run unit-merge && npm run unit-report",
    "e2e-merge": "mochawesome-merge cypress/results/e2e/*.json > e2e-mochawesome.json",
    "unit-merge": "mochawesome-merge cypress/results/unit/*.json > unit-mochawesome.json",
    "e2e-report": "npx marge e2e-mochawesome.json",
    "unit-report": "npx marge unit-mochawesome.json",
    "cy:run:report": "nyc cypress run",
    "test": "npm run unit-test && npm run e2e-test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/morningsoccerleague/morningsoccerleague.github.io"
  },
  "bugs": {
    "url": "https://github.com/morningsoccerleague/morningsoccerleague.github.io/issues"
  }
}
